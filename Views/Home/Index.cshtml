@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4 text-primary">
        @ViewBag.libraryName
    </h1>
    <br />
    <p class="lead">
        Welcome to the Index Page!
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h3 class="card-title">
                Total Books
            </h3>

            <h2 class="text-success">
                @ViewBag.TotalBooks
            </h2>

            <a class="btn btn-primary"
               href="/Home/Index">
                Home
            </a>
        </div>
    </div>
</div>